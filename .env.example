# Kopieer dit bestand naar .env en vul het in. .env komt niet in git.
# Wordt gelezen door docker-compose.online.yml (Caddy) en docker-compose.cloudflare.yml (Cloudflare Tunnel).

# Alleen voor de Caddy-versie: het adres waarop het spel online staat. Er moet een A-record naar je publieke IP-adres wijzen.
# Bij de Cloudflare Tunnel staat het adres in cloudflared/config.yml.
DOMAIN=ermetd.harrevelt.nl

# Wachtwoord van de webadmin op /admin (minstens 10 tekens). Leeg = webadmin uit.
ADMIN_PASSWORD=
