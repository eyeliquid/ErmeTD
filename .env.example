# Kopieer dit bestand naar .env en vul het in. .env komt niet in git.
# Wordt gelezen door docker-compose.yml.

# Token van de Cloudflare Tunnel. Te vinden in het Cloudflare-dashboard bij de tunnel (Zero Trust > Networks > Tunnels).
# Het is de lange tekst achter --token in het installatiecommando voor Docker.
TUNNEL_TOKEN=

# Wachtwoord van de webadmin op /admin (minstens 10 tekens). Leeg = webadmin uit.
ADMIN_PASSWORD=
