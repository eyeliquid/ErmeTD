# Instellingen van de server. Alles is optioneel; dit zijn de standaardwaarden.
# De server leest deze uit de omgeving (zet ze bij je host, of start met: node --env-file=.env src/index.js).

PORT=3000

# Map waar de database (ratd.sqlite) komt. Zet dit bij hosting op een schijf die blijft bestaan.
DATA_DIR=./data

# Aantal proxy's voor de server. Bij de meeste hostingplatforms is dat 1.
# Laat op 0 staan als spelers rechtstreeks met de server verbinden.
TRUST_PROXY=0

# Alleen nodig als de frontend op een ander adres staat dan de server: toegestane adressen, gescheiden door komma's.
CORS_ORIGINS=

# Na zoveel dagen zonder bezoek moet een speler opnieuw inloggen.
SESSION_DAYS=90

# Hoeveel browsers tegelijk met de lobby verbonden mogen zijn, in totaal en per IP-adres.
MAX_PEERS=200
MAX_PEERS_PER_IP=8
